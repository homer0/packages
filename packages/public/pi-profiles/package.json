{
  "name": "@homer0/pi-profiles",
  "version": "1.0.0",
  "type": "module",
  "description": "Profiles for Pi: toggle sets of skills, extensions, and context per project or machine",
  "author": "Leonardo Apiwan (@homer0) <me@homer0.com>",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "profiles"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homer0/packages.git",
    "directory": "packages/public/pi-profiles"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "files": [
    "dist/",
    "src/",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./dist/extensions/profiles.js"
    ]
  },
  "dependencies": {
    "@homer0/pi-config": "workspace:^",
    "jiti": "2.7.0",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@homer0/oxlint-config": "workspace:*",
    "@homer0/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsdown": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "lint": "oxlint .",
    "lint:all": "oxlint .",
    "lint:file": "oxlint $@",
    "test": "vitest run $@",
    "types:check": "tsc --noEmit",
    "build": "tsdown",
    "prepublishOnly": "pnpm run build"
  }
}
