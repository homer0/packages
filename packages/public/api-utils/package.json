{
  "name": "@homer0/api-utils",
  "description": "A few utilities to work with APIs.",
  "version": "6.0.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homer0/packages.git",
    "directory": "packages/public/api-utils"
  },
  "author": "Leonardo Apiwan (@homer0) <me@homer0.com>",
  "license": "MIT",
  "keywords": [
    "api",
    "fetch",
    "utility",
    "wootils",
    "javascript"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "devDependencies": {
    "@homer0/object-utils": "workspace:*",
    "@homer0/oxlint-config": "workspace:*",
    "@homer0/tsconfig": "workspace:*",
    "@types/urijs": "^1.19.26",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "urijs": "^1.19.11",
    "vitest": "catalog:"
  },
  "engine-strict": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "oxlint .",
    "lint:file": "oxlint $@",
    "test": "vitest run $@",
    "types:check": "tsc --noEmit && tsc --noEmit --project ./tests/tsconfig.json",
    "build": "tsdown",
    "prepublishOnly": "pnpm run build"
  }
}
