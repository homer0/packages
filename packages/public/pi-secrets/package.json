{
  "name": "@homer0/pi-secrets",
  "version": "1.1.0",
  "type": "module",
  "description": "Resolve secrets from providers like Infisical, for Pi extensions, tools, and skills",
  "author": "Leonardo Apiwan (@homer0) <me@homer0.com>",
  "license": "MIT",
  "keywords": [
    "pi",
    "secrets",
    "infisical"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homer0/packages.git",
    "directory": "packages/public/pi-secrets"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "files": [
    "dist/",
    "src/",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@homer0/pi-config": "workspace:^",
    "@homer0/pi-in-memory-cache": "workspace:^",
    "ms": "2.1.3",
    "undici": "^8.12.3",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@homer0/oxlint-config": "workspace:*",
    "@homer0/tsconfig": "workspace:*",
    "@types/ms": "2.1.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint .",
    "lint:all": "oxlint .",
    "lint:file": "oxlint $@",
    "test": "vitest run $@",
    "types:check": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  }
}
