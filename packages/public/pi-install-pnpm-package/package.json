{
  "name": "@homer0/pi-install-pnpm-package",
  "version": "1.0.0",
  "type": "module",
  "description": "Install and uninstall pnpm-backed Pi packages from slash commands, in a Pi config repo that uses a pnpm workspace",
  "author": "Leonardo Apiwan (@homer0) <me@homer0.com>",
  "license": "MIT",
  "keywords": [
    "pi",
    "pnpm",
    "extension",
    "install"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homer0/packages.git",
    "directory": "packages/public/pi-install-pnpm-package"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist/",
    "src/",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./dist/install-pnpm-package.js"
    ]
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@homer0/oxlint-config": "workspace:*",
    "@homer0/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint .",
    "lint:all": "oxlint .",
    "lint:file": "oxlint $@",
    "test": "vitest run $@",
    "types:check": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  }
}
