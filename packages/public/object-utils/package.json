{
  "name": "@homer0/object-utils",
  "description": "A small collection of utility methods to work with objects.",
  "version": "6.0.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homer0/packages.git",
    "directory": "packages/public/object-utils"
  },
  "author": "Leonardo Apiwan (@homer0) <me@homer0.com>",
  "license": "MIT",
  "keywords": [
    "object",
    "extend",
    "utility",
    "wootils",
    "javascript"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "extend": "^3.0.2"
  },
  "devDependencies": {
    "@homer0/oxlint-config": "workspace:*",
    "@homer0/tsconfig": "workspace:*",
    "@types/extend": "^3.0.4",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  },
  "engine-strict": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "oxlint .",
    "lint:file": "oxlint $@",
    "test": "vitest run $@",
    "types:check": "tsc --noEmit && tsc --noEmit --project ./tests/tsconfig.json",
    "build": "tsdown",
    "prepublishOnly": "pnpm run build"
  }
}
