{
  "name": "packages",
  "description": "Monorepo",
  "homepage": "https://homer0.dev",
  "version": "0.0.0-development",
  "repository": "homer0/packages",
  "author": "Leonardo Apiwan (@homer0) <me@homer0.com>",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "dependencies": {},
  "devDependencies": {
    "@homer0/oxfmt-config": "workspace:*",
    "@homer0/oxlint-config": "workspace:*",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "catalog:",
    "oxfmt": "^0.62.0",
    "oxlint": "catalog:",
    "husky": "^9.1.7",
    "leasot": "^14.4.0",
    "lerna": "^10.0.0",
    "lint-staged": "^17.3.0"
  },
  "engine-strict": true,
  "engines": {
    "node": ">=22"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,scss,md}": [
      "oxfmt"
    ],
    "*.{ts,tsx,js,jsx}": [
      "oxlint"
    ]
  },
  "scripts": {
    "build": "./utils/scripts/build",
    "test": "./utils/scripts/test",
    "types:check": "./utils/scripts/types-check",
    "lint": "./utils/scripts/lint",
    "lint:all": "./utils/scripts/lint-all",
    "format:all": "oxfmt",
    "format:check": "oxfmt --check",
    "todo": "./utils/scripts/todo",
    "prepare": "./utils/scripts/prepare"
  }
}
